# macOS system files
.DS_Store
._*
.Spotlight-V100
.Trashes

# Claude Code settings (project-specific, don't sync to home)
/.claude/

# Parallel development
.worktrees/
.parallel-context.md

# MCP server runtime data (databases, logs)
home/.claude/contrib/agent-event-bus/
home/.claude/contrib/agent-session-analytics/
home/.claude/contrib/agent-memory-store/

# Zellij saved layouts (machine-specific snapshots, but keep default.kdl)
home/.config/zellij/layouts/*
!home/.config/zellij/layouts/default.kdl
!home/.config/zellij/layouts/default.swap.kdl
home/.config/zellij/layouts/saved-layout.kdl
