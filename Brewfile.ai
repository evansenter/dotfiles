# Brewfile.ai - AI assistant dependencies (Claude, agent CLI tools)
# Installed conditionally via bootstrap.sh

# Mesh VPN (event bus, MCP services)
cask "tailscale-app"

# Claude Code
cask "claude"

# OpenAI Terminal Agent
cask "codex"

# Local LLM runner
cask "lm-studio"

# Local speech-to-text
brew "whisper-cpp"

# Agent CLI tools
brew "gogcli"                     # Google Suite CLI (backs the `gog` Claude skill)
