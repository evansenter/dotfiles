# Brewfile.ai - AI assistant dependencies (Claude, OpenClaw)
# Installed conditionally via bootstrap.sh

# Claude Code
cask "claude"

# OpenAI Terminal Agent
cask "codex"

# Local LLM runner
cask "lm-studio"

# Local speech-to-text
brew "whisper-cpp"

# Tailscale Mesh VPN (event bus, openclaw)
cask "tailscale-app"

# OpenClaw Agent Tools
brew "spotify_player"             # Spotify CLI (OAuth device flow)
brew "gogcli"                     # Google Suite CLI
