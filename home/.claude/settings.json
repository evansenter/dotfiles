{
  "cleanupPeriodDays": 365,
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "WebSearch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git mv:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git worktree:*)",
      "Bash(git -C:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr create:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr review:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh run watch:*)",
      "Bash(gh api:*)",
      "Bash(gh repo view:*)",
      "Bash(make:*)",
      "Bash(cargo check:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo run:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo add:*)",
      "Bash(LOUD_WIRE=1:*)",
      "mcp__github__*",
      "mcp__notion__*",
      "mcp__event-bus__*",
      "EnterPlanMode",
      "Bash(RUSTDOCFLAGS=\"-D warnings\" cargo doc:*)",
      "Skill(pr-review-toolkit:review-pr)",
      "Skill(commit-commands:commit-push-pr)",
      "Skill(watch-ci)",
      "Bash(rm:*)",
      "Bash(tmux:*)",
      "Bash(date:*)",
      "Bash(source:*)",
      "Bash(sed:*)",
      "Bash(mkdir:*)",
      "Skill(rfc)",
      "Bash(.venv/bin/python3:*)",
      "Bash(.venv/bin/pip:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(~/.claude/contrib/*:*)",
      "Bash(./bootstrap.sh:*)",
      "Bash(./uninstall.sh:*)",
      "Bash(./tests/*.sh:*)",
      "Bash(cargo +nightly:*)",
      "mcp__session-analytics__*",
      "Bash(uv:*)",
      "Bash(event-bus-cli:*)",
      "Bash(~/.local/bin/event-bus-cli:*)",
      "Bash(session-analytics-cli:*)",
      "Bash(.venv/bin/session-analytics-cli:*)",
      "Bash(sqlite3:*)",
      "Bash(launchctl:*)",
      "Bash(claude:*)",
      "Bash(chmod:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(sleep:*)",
      "Bash(find:*)",
      "Bash(bash:*)",
      "Bash(which:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(timeout:*)",
      "Bash(cp:*)",
      "Bash(curl:*)"
    ],
    "defaultMode": "default"
  },
  "model": "opus",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/prompt-events.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-end.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-compact.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  }
}
