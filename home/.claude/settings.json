{
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-hook.sh"
          },
          {
            "type": "prompt",
            "prompt": "The stop-hook gathered this context: {{output}}. Evaluate if Claude should stop. Return ok=false (with reason) to continue working if: (1) CI is pending/running, (2) there are unprocessed PR comments (feedback_count > 0), (3) a recent push needs CI monitoring. Return ok=true if none of these conditions apply."
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          }
        ]
      }
    ]
  }
}
