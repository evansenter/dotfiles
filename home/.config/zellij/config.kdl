// Zellij configuration
// Docs: https://zellij.dev/documentation/

// Catppuccin Mocha theme (built-in)
theme "catppuccin-mocha"

// Plugins
plugins {
    autolock location="file:~/.config/zellij/plugins/zellij-autolock.wasm" {
        is_enabled true
        triggers "nvim|vim|git|fzf|zoxide|atuin|helix|claude"
        reaction_seconds "1.0"
    }
    forgot location="file:~/.config/zellij/plugins/zellij-forgot.wasm" {
        "LOAD_ZELLIJ_BINDINGS" "true"
    }
}

load_plugins {
    autolock
}

// Session management
pane_viewport_serialization true  // Save scrollback on exit
on_force_close "detach"           // Ctrl+q detaches instead of killing
scroll_buffer_size 50000          // Match tmux history-limit

// Mouse support
mouse_mode true

// Borderless panes by default
pane_frames false

// Copy to system clipboard
copy_on_select true

// Keybindings
keybinds {
    session {
        // Ctrl+o then ? to open forgot (keybinding cheatsheet)
        bind "?" { LaunchOrFocusPlugin "forgot" floating="true"; SwitchToMode "Normal"; }
    }
}
