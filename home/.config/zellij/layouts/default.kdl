// Default layout with zjstatus status bar
// Catppuccin Mocha colors: https://catppuccin.com/palette

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left   "{command_host}"
                format_center ""
                format_right  "{datetime}"
                format_space  ""

                border_enabled  "false"

                hide_frame_for_single_pane "true"

                // Hostname (static, only runs once)
                command_host_command    "hostname -s"
                command_host_format     "#[fg=#6c7086]{stdout}"
                command_host_interval   "0"
                command_host_rendermode "static"

                // Datetime
                datetime          "#[fg=#6c7086]{format}"
                datetime_format   "%Y-%m-%d %H:%M"
                datetime_timezone "Local"
            }
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}
