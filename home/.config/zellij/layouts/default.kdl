// Default layout with zjstatus status bar
// Catppuccin Mocha colors: https://catppuccin.com/palette

layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left   "{mode} #[fg=#89b4fa,bold]{session}"
                format_center "{tabs}"
                format_right  "{command_host} {datetime}"
                format_space  ""

                border_enabled  "false"

                hide_frame_for_single_pane "true"

                // Catppuccin Mocha mode colors
                mode_normal        "#[bg=#89b4fa,fg=#1e1e2e,bold] NORMAL "
                mode_locked        "#[bg=#6c7086,fg=#1e1e2e,bold] LOCKED "
                mode_resize        "#[bg=#f9e2af,fg=#1e1e2e,bold] RESIZE "
                mode_pane          "#[bg=#a6e3a1,fg=#1e1e2e,bold] PANE "
                mode_tab           "#[bg=#cba6f7,fg=#1e1e2e,bold] TAB "
                mode_scroll        "#[bg=#fab387,fg=#1e1e2e,bold] SCROLL "
                mode_enter_search  "#[bg=#f38ba8,fg=#1e1e2e,bold] SEARCH "
                mode_search        "#[bg=#f38ba8,fg=#1e1e2e,bold] SEARCH "
                mode_rename_tab    "#[bg=#cba6f7,fg=#1e1e2e,bold] RENAME "
                mode_rename_pane   "#[bg=#a6e3a1,fg=#1e1e2e,bold] RENAME "
                mode_session       "#[bg=#89dceb,fg=#1e1e2e,bold] SESSION "
                mode_move          "#[bg=#94e2d5,fg=#1e1e2e,bold] MOVE "
                mode_prompt        "#[bg=#cba6f7,fg=#1e1e2e,bold] PROMPT "
                mode_tmux          "#[bg=#fab387,fg=#1e1e2e,bold] TMUX "

                // Tab styling
                tab_normal              "#[fg=#6c7086] {name} "
                tab_normal_fullscreen   "#[fg=#6c7086] {name} [] "
                tab_normal_sync         "#[fg=#6c7086] {name} <> "
                tab_active              "#[fg=#cdd6f4,bold] {name} "
                tab_active_fullscreen   "#[fg=#cdd6f4,bold] {name} [] "
                tab_active_sync         "#[fg=#cdd6f4,bold] {name} <> "
                tab_separator           "#[fg=#45475a] | "

                // Hostname (static, only runs once)
                command_host_command    "hostname -s"
                command_host_format     "#[fg=#6c7086]{stdout}"
                command_host_interval   "0"
                command_host_rendermode "static"

                // Datetime
                datetime          "#[fg=#6c7086] {format} "
                datetime_format   "%Y-%m-%d %H:%M"
                datetime_timezone "Local"
            }
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}
