# ==============================================================================
# Environment Variables
# ==============================================================================

# Variables expected in ~/.extra (not tracked):
#   GITHUB_TOKEN   - Required for Claude Code GitHub MCP server
#   GEMINI_API_KEY - Required for Gemini API access
#   AGENT_EVENT_BUS_URL - URL for event bus MCP server (e.g., https://host/agent-event-bus/mcp)

# PATH configuration
if [ -d "$HOME/.local/bin" ]; then
    export PATH="$HOME/.local/bin:$PATH"
fi
if [ -d "$HOME/.npm-global/bin" ]; then
    export PATH="$HOME/.npm-global/bin:$PATH"
fi
if [ -d "$HOME/.cargo/bin" ]; then
    export PATH="$HOME/.cargo/bin:$PATH"
fi
if [ -d "/usr/local/go/bin" ]; then
    export PATH="/usr/local/go/bin:$PATH"
fi

# Default editor
export EDITOR='hx'

# Truecolor support - apps check this env var for 24-bit color capability
export COLORTERM='truecolor'

# Enable ANSI colors in less (for git log, man pages, etc.)
export LESS='-R'

# Claude Code statusline - disable hyperlinks due to injection corruption (#172)
export STATUSLINE_NO_LINKS=1

# Suppress Node.js deprecation warnings (e.g., DEP0040 punycode)
export NODE_NO_WARNINGS=1

# Cache for rustc artifacts, to speed up `make check`-like commands
command -v sccache >/dev/null && export RUSTC_WRAPPER=sccache

# Google Cloud SDK - enables site-packages for IAP TCP forwarding bandwidth
# https://docs.cloud.google.com/iap/docs/using-tcp-forwarding#increasing_the_tcp_upload_bandwidth
export CLOUDSDK_PYTHON_SITEPACKAGES=1

# Glamour (glow, gh) - Catppuccin Mocha theme
if [[ -f "$HOME/.config/glamour/catppuccin-mocha.json" ]]; then
    export GLAMOUR_STYLE="$HOME/.config/glamour/catppuccin-mocha.json"
fi

# eza - Catppuccin Mocha theme (force ~/.config/eza on all platforms)
export EZA_CONFIG_DIR="$HOME/.config/eza"

# fzf - Catppuccin Mocha theme
# Colors: bg=background, fg=foreground, hl=highlight, info=match count,
#         prompt=input prompt, pointer=selection arrow, marker=multi-select,
#         spinner=loading, header=header text, selected-bg=current line bg
export FZF_DEFAULT_OPTS=" \
--color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
--color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
--color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8 \
--color=selected-bg:#45475a"
