{
  "zellij-status": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "~/.claude/hooks/zj-status.sh working < /dev/null; echo '{}'"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "~/.claude/hooks/zj-status.sh waiting < /dev/null; echo '{}'"
      }
    ]
  }
}
