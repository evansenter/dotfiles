{
  "agents": {
    "defaults": {
      "workspace": "${HOME}/clawd",
      "compaction": {
        "mode": "safeguard"
      },
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8
      }
    }
  },
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },
  "gateway": {
    "mode": "remote",
    "remote": {
      "url": "wss://mac-mini.tailac7b3c.ts.net/",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "skills": {
    "install": {
      "nodeManager": "npm"
    }
  }
}
